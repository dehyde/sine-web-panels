[
  {
    "type": "checkbox",
    "label": "Enable Web Panels",
    "property": "sine.web-panels.enabled",
    "defaultValue": true
  },
  {
    "type": "dropdown",
    "label": "Panel shortcut",
    "property": "sine.web-panels.shortcut-modifier",
    "defaultValue": "accel+alt",
    "placeholder": false,
    "options": [
      {
        "value": "disabled",
        "label": "Disabled"
      },
      {
        "value": "accel",
        "label": "Ctrl / ⌘ + 1…0"
      },
      {
        "value": "accel+alt",
        "label": "Ctrl / ⌘ + Alt / ⌥ + 1…0"
      },
      {
        "value": "accel+shift",
        "label": "Ctrl / ⌘ + Shift + 1…0"
      },
      {
        "value": "alt",
        "label": "Alt / ⌥ + 1…0"
      },
      {
        "value": "alt+shift",
        "label": "Alt / ⌥ + Shift + 1…0"
      }
    ]
  },
  {
    "type": "separator",
    "label": "Appearance"
  },
  {
    "type": "string",
    "label": "Resize handle colour — leave empty to follow the browser theme",
    "property": "sine.web-panels.resizer-color",
    "defaultValue": "",
    "placeholder": "#3b82f6, rebeccapurple, oklch(0.7 0.2 250)…"
  }
]
